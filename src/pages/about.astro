---
/**
 * About page
 * URL: /about
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
import TypingEffect from '@/components/ui/TypingEffect.astro';
import TechStack from '@/components/landing/TechStack.astro';
import siteConfig from '@/config/site.config';

const location = siteConfig.address?.city
  ? `${siteConfig.address.city}${siteConfig.address.country ? `, ${siteConfig.address.country}` : ''}`
  : null;
---

<PageLayout
  title={`Sobre mí — ${siteConfig.name}`}
  description="Conoce a Dario Ezequiel Kupec, creador de DeltaCode. Profesor de matemática y desarrollador enfocado en la integración de tecnología y educación."
>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="user" size="sm" />
      Sobre mí
    </Badge>
    <h1 slot="title">
      <span class="text-foreground [-webkit-text-fill-color:currentColor]">DeltaCode —</span><br />
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)]">
        <TypingEffect
          words={[
            'Matemática Aplicada',
            'Gestión Educativa',
            'Divulgación STEM',
            'Innovación Educativa',
            'Python para Docentes',
          ]}
        />
      </span>
    </h1>

    <p slot="description">
      Matemático de formación y programador por curiosidad. <br />Mi objetivo es proporcionar
      herramientas en Python que resuelvan problemas reales, ayudando a que veamos a la Matemática
      de otra manera.
    </p>
  </Hero>

  <!-- What's possible now -->
  <section class="bg-brand-500/8 dark:bg-background-secondary py-[var(--space-section-md)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-12 lg:grid-cols-2">
        <!-- Left: text -->
        <div class="flex flex-col gap-4" data-reveal>
          <div class="flex flex-col gap-6">
            <Badge variant="brand" pill class="self-start">Flujo de Trabajo</Badge>
            <h2 class="font-display text-foreground text-3xl font-bold md:text-4xl">
              Didáctica Matemática Creativa
            </h2>
          </div>
          <p class="text-foreground-muted text-lg leading-relaxed">
            Como profesor de matemática, mi objetivo es que la tecnología no sea un atajo, sino un
            puente. Utilizo herramientas de IA para pensar nuevas formas de explicar conceptos
            complejos y revisar el código de mis proyectos educativos.
          </p>
          <p class="text-foreground-muted text-lg leading-relaxed">
            No se trata de automatizar el aprendizaje, sino de elevar el nivel de la enseñanza. Cada
            problema sigue teniendo una intención pedagógica y cada script de Python está diseñado
            con un propósito. La IA me ayuda a ser un docente más riguroso y creativo.
          </p>
        </div>
        <!-- Right: two stacked partner cards -->
        <div class="flex h-full flex-col gap-4" data-reveal data-reveal-delay="1">
          <Card variant="elevated" hover class="flex flex-1 flex-col justify-center">
            <div class="flex items-start gap-4">
              <div
                class="from-brand-500/20 to-brand-500/5 text-brand-500 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br"
              >
                <Icon name="code-2" size="md" />
              </div>
              <div class="min-w-0 flex-1">
                <p class="casesensitive text-foreground-muted mb-1 text-xs font-bold tracking-wide">
                  Profesor y Desarrollador
                </p>
                <h3 class="text-foreground text-base font-semibold">Dario Kupec</h3>
                <p class="text-foreground-muted mt-1.5 text-sm leading-relaxed">
                  Especialista en Educación Matemática y Gestión Educativa. Enfocado en la creación
                  de recursos STEM prácticos y accesibles.{
                    location
                      ? ` Resido en ${location}, Trabajo de manera online.`
                      : ' Trabajo de manera online.'
                  }
                </p>
                <div class="mt-3 flex flex-wrap gap-1.5">
                  <Badge size="sm" variant="brand">Matemática</Badge>
                  <Badge size="sm" variant="brand">Python</Badge>
                  <Badge size="sm" variant="brand">Google Colab</Badge>
                </div>
              </div>
            </div>
          </Card>
          <Card
            variant="elevated"
            hover
            rel="noopener noreferrer"
            class="group flex flex-1 flex-col justify-center"
          >
            <div class="flex items-start justify-between gap-4">
              <div class="flex min-w-0 flex-1 items-start gap-4">
                <div
                  class="from-brand-500/20 to-brand-500/5 text-brand-500 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br"
                >
                  <Icon name="sparkles" size="md" />
                </div>
                <div class="min-w-0 flex-1">
                  <p
                    class="casesensitive text-foreground-muted mb-1 text-xs font-bold tracking-wide"
                  >
                    IA como asistente
                  </p>
                  <h3 class="text-foreground text-base font-semibold">Inteligencia Artificial</h3>
                  <p class="text-foreground-muted mt-1.5 text-sm leading-relaxed">
                    Soporte en la optimización de algoritmos, generación de casos de prueba
                    matemáticos y refinamiento de la experiencia de usuario en entornos educativos.
                  </p>
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    <Badge size="sm" variant="brand">Pensamiento Algorítmico</Badge>
                    <Badge size="sm" variant="brand">QA de Código</Badge>
                    <Badge size="sm" variant="brand">Resolución de Problemas</Badge>
                  </div>
                </div>
              </div>
              <Icon
                name="arrow-up-right"
                size="sm"
                class="text-foreground-muted group-hover:text-brand-500 shrink-0 transition-colors"
              />
            </div>
          </Card>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="border-border border-t py-[var(--space-section-md)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-8 flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>Metodología</Badge>
          <h2 class="font-display text-foreground text-4xl font-bold">Cómo construyo DeltaCode</h2>
        </div>
        <p class="text-foreground-muted mx-auto max-w-2xl text-lg text-balance">
          Más que un sitio de recursos, es un compromiso con la claridad, la rigurosidad matemática
          y la innovación tecnológica en el aula.
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-3" data-reveal data-reveal-delay="1">
        <Card hover>
          <div class="flex items-start gap-4">
            <div
              class="from-brand-500/20 to-brand-500/5 text-brand-500 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br"
            >
              <Icon name="zap" size="md" />
            </div>
            <div class="min-w-0 flex-1">
              <h3 class="text-foreground text-base font-semibold">Matemática Aplicada</h3>
              <p class="text-foreground-muted mt-1.5 text-sm leading-relaxed">
                Cada proyecto nace de un concepto matemático sólido, transformando la teoría
                abstracta en algoritmos comprensibles y funcionales a la enseñanza.
              </p>
            </div>
          </div>
        </Card>
        <Card hover>
          <div class="flex items-start gap-4">
            <div
              class="from-brand-500/20 to-brand-500/5 text-brand-500 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br"
            >
              <Icon name="award" size="md" />
            </div>
            <div class="min-w-0 flex-1">
              <h3 class="text-foreground text-base font-semibold">Docencia en el Aula</h3>
              <p class="text-foreground-muted mt-1.5 text-sm leading-relaxed">
                Mi experiencia docente me ha ayudado a desarrollar un método que permite a los
                estudiantes redescubrir la matemática mediante la recreación en un ámbito de flujo
                de ideas.
              </p>
            </div>
          </div>
        </Card>
        <Card hover>
          <div class="flex items-start gap-4">
            <div
              class="from-brand-500/20 to-brand-500/5 text-brand-500 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br"
            >
              <Icon name="rocket" size="md" />
            </div>
            <div class="min-w-0 flex-1">
              <h3 class="text-foreground text-base font-semibold">Programación Didáctica</h3>
              <p class="text-foreground-muted mt-1.5 text-sm leading-relaxed">
                Utilizo herramientas modernas como Python y Google Colab, para crear recursos que no
                solo resuelven problemas, sino que invitan a los alumnos a experimentar.
              </p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- My Stack -->
  <TechStack
    badge="Herramientas y Tecnología"
    title="Mi Stack Tecnológico"
    description="Las tecnologías que utilizo para unir la matemática y el código. Seleccionadas por su potencia didáctica, facilidad de aprendizaje y solidez técnica."
  />
  <!-- CTA -->
  <section class="bg-background py-[var(--space-section-md)]">
    <div class="mx-auto max-w-2xl px-6 text-center" data-reveal>
      <h2 class="font-display text-foreground mb-4 text-4xl font-bold text-balance">
        ¿Te interesa esta propuesta?
      </h2>
      <p class="text-foreground-muted mb-8 text-lg text-balance">
        Si eres docente, estudiante o apasionado de la tecnología y quieres conocer cómo implementar
        estas ideas, te invito a que te comuniques conmigo para que podamos empezar a cambiar la
        enseñanza de la matemática...
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <Button size="lg" href="/contact">
          Comencemos
          <Icon name="arrow-right" size="sm" />
        </Button>
        <Button size="lg" variant="outline" href="/blog"> Ver Recursos </Button>
      </div>
    </div>
  </section>
</PageLayout>
